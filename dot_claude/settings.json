{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(pnpm:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Edit(./**)",
      "Read(./**)",
      "WebFetch",
      "WebSearch",
      "Write(./**)"
    ],
    "deny": [
      "Bash(git push -f:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(rm -rf:*)",
      "Read(**/.dev.vars)",
      "Read(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.npmrc)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "plansDirectory": ".claude/plans",
  "showThinkingSummaries": true,
  "skipAutoPermissionPrompt": true
}
